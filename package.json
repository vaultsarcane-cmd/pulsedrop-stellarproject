{
  "name": "pulsedrop-stellar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rapid Stellar Testnet XLM assistance-payment presets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
